# Copy to .env and fill in. .env is gitignored and never committed (scripts/check_secrets.py).
# You only need the keys for stages that are stale: with the committed outputs/, `make film`
# from a clean clone is all cache hits plus FFmpeg and needs no keys at all.

# Gemini API (script, storyboard draft, narration TTS)
# Google AI Studio -> Get API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare Workers AI (keyframes, reference sheets)
# Dashboard -> Workers AI -> "Use REST API": copy the Account ID, then
# "Create a Workers AI API Token". Use a scoped API token, NOT the Global API Key.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Kaggle (Wan 2.2 moving shots, ACE-Step music; needs a phone-verified account for GPU + internet)
# kaggle.com -> Settings -> API -> Generate New Token. (Or put kaggle.json in ~/.kaggle/.)
KAGGLE_API_TOKEN=

# Provider profile: free (default) or paid (see config/providers.yaml, docs/PAID_LANE.md)
PROFILE=free
